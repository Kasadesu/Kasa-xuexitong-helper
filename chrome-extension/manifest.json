{
  "manifest_version": 3,
  "name": "Kasa-xuexitong-helper",
  "version": "1.4.2",
  "description": "超星学习通与知到智慧树双平台课程与作业辅助扩展",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.mti100.com/*",
    "*://*.zhihuishu.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*",
        "*://*.mti100.com/*",
        "*://*.zhihuishu.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
